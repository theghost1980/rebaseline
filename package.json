{
  "name": "rebaseline",
  "version": "0.1.0-beta.1",
  "description": "Review failed Playwright screenshots in your browser and accept them into their baseline files, also from GitHub Actions runs. No Docker.",
  "keywords": [
    "playwright",
    "visual-regression",
    "screenshot-testing",
    "snapshot-testing",
    "toHaveScreenshot",
    "baseline",
    "github-actions",
    "e2e",
    "testing",
    "cli"
  ],
  "type": "module",
  "bin": {
    "rebaseline": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "fixtures": "node scripts/fixtures.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theghost1980/rebaseline.git"
  },
  "homepage": "https://github.com/theghost1980/rebaseline#readme",
  "bugs": {
    "url": "https://github.com/theghost1980/rebaseline/issues"
  },
  "author": "Saturno Mangieri (https://github.com/theghost1980)",
  "license": "MIT",
  "publishConfig": {
    "tag": "beta"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "cac": "^7.1.0",
    "fflate": "^0.8.3",
    "picocolors": "^1.1.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
